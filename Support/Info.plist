<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>AirMonitor</string>
    <key>CFBundleDisplayName</key>
    <string>AirMonitor</string>
    <key>CFBundleIdentifier</key>
    <string>local.airmonitor.menubar</string>
    <key>CFBundleExecutable</key>
    <string>AirMonitor</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.3</string>
    <key>CFBundleVersion</key>
    <string>4</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!-- No Dock icon: the app lives in the menu bar -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Allows plain http:// for the local device (http://192.168.x.x/data.json) -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>AirMonitor reads data directly from your Nettigo Air Monitor on your local network.</string>
</dict>
</plist>
